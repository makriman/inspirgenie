---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  canonical?: string;
  noindex?: boolean;
  /** `overlay` sits on a dark hero. `solid` is for pages with a light top. */
  headerTone?: 'overlay' | 'solid';
}

const { headerTone = 'overlay', ...layoutProps } = Astro.props;
---
<BaseLayout {...layoutProps}>
  <slot name="head" slot="head" />
  <Header tone={headerTone} />
  <main>
    {headerTone === 'solid' && <div class="h-16 lg:h-20" aria-hidden="true"></div>}
    <slot />
  </main>
  <Footer />
</BaseLayout>
